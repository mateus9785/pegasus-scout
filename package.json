{
  "name": "pegasus-scout",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Etapa 1 do Projeto Pegasus: mapeia empresas, enriquece dados publicos e pontua a chance de o atendimento ainda ser manual.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scout": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:int"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "mysql2": "^3.11.3",
    "pino": "^9.5.0",
    "playwright": "^1.49.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxlint": "^1.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
