{
  "compilerOptions": {
    "target": "ES2023",
    // "DOM" e necessario porque os callbacks de page.evaluate() do Playwright
    // rodam dentro do navegador e usam `document`. O custo e que os globais de DOM
    // ficam visiveis no codigo de Node tambem -- nao ha como escopar por arquivo.
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
