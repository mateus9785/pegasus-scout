# ---------------------------------------------------------------------------
# MySQL — o MESMO banco do artificialstudio. As tabelas scout_* vivem lá, e o
# DDL delas fica em artificialstudio/backend/src/db/schema.sql (fonte unica).
# Suba o banco com `docker compose up -d` dentro de artificialstudio/ e aplique
# o schema com `npm run migrate` em artificialstudio/backend/.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3307
DB_USER=artificialcode
DB_PASSWORD=artificialcode
DB_NAME=artificialcode

# Banco usado SO pelos testes de integracao. Precisa ser diferente de DB_NAME:
# as suites truncam as tabelas scout_* e nao devem tocar seus dados de trabalho.
DB_NAME_TEST=artificialcode_test

# ---------------------------------------------------------------------------
# Log
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
SCOUT_LOG_LEVEL=info
# true = log estruturado em JSON (produzido por pino). false = legivel no terminal.
SCOUT_LOG_JSON=false

# ---------------------------------------------------------------------------
# Navegador
# ---------------------------------------------------------------------------
# Onde ficam os perfis persistidos por alvo (data/profiles/maps, /whatsapp, ...).
# Voce loga uma vez com `npm run scout -- login <alvo>` e os runs seguintes
# reaproveitam os cookies sem pedir senha nem QR de novo.
SCOUT_PROFILE_DIR=./data/profiles

# false abre o navegador visivel. O comando `login` SEMPRE abre visivel,
# independente disso — nao ha como escanear um QR code headless.
SCOUT_HEADLESS=true

# Janela de espera aleatoria entre acoes no navegador, em ms. Existe para nao
# parecer um robo metronomico: e o que reduz CAPTCHA no Google e action block
# na Meta. Nao baixe muito.
SCOUT_MIN_DELAY_MS=1200
SCOUT_MAX_DELAY_MS=3500

# ---------------------------------------------------------------------------
# Tetos de seguranca (por execucao / por dia)
# ---------------------------------------------------------------------------
# Quantos perfis sociais e quantos numeros de WhatsApp podem ser consultados por
# dia usando SUAS contas. Volume alto e o que dispara bloqueio da Meta.
SCOUT_SOCIAL_DAILY_LIMIT=40
SCOUT_WA_DAILY_LIMIT=40

# Timeout de requisicao HTTP simples (busca do site da empresa), em ms.
SCOUT_HTTP_TIMEOUT_MS=10000
# Teto de bytes lidos de um site. Evita engasgar num PDF ou num video.
SCOUT_HTTP_MAX_BYTES=2000000

# ---------------------------------------------------------------------------
# Geocoding (Nominatim / OpenStreetMap — gratuito)
# ---------------------------------------------------------------------------
# A politica de uso do Nominatim exige um User-Agent identificavel com contato
# real. Sem isso o servico pode bloquear o IP. Coloque um e-mail seu.
SCOUT_NOMINATIM_EMAIL=
